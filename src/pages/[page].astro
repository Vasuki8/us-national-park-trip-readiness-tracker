---
import type { InferGetStaticPropsType } from 'astro';
import Layout from '../layouts/Layout.astro';
import { informationPages } from '../lib/content';
export function getStaticPaths() { return informationPages.map((page) => ({ params: { page: page.slug }, props: { page } })); }
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props;
---
<Layout title={page.title}><article class="prose-page"><header class="page-intro"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lead">{page.intro}</p></header><div class="prose-sections">{page.sections.map((section) => <section><h2>{section.title}</h2><p>{section.text}</p>{'links' in section && section.links?.map((link) => <p><a class="text-link" href={link.url}>{link.label} <span aria-hidden="true">↗</span></a></p>)}</section>)}</div></article></Layout>
