---
import type { InferGetStaticPropsType } from 'astro';
import Layout from '../layouts/Layout.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import { informationPages } from '../lib/content';
import { parks, historyFor, snapshotFor } from '../lib/data';
import { siteUrl } from '../lib/urls';
export function getStaticPaths() { return informationPages.map((page) => ({ params: { page: page.slug }, props: { page } })); }
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props;
---
<Layout title={page.title}><article class="prose-page"><header class="page-intro"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lead">{page.intro}</p></header><div class="prose-sections">{page.sections.map((section) => <section><h2>{section.title}</h2><p>{section.text}</p>{'links' in section && section.links?.map((link) => <p><a class="text-link" href={siteUrl(link.url, import.meta.env.BASE_URL)}>{link.label} <span aria-hidden="true">↗</span></a></p>)}</section>)}</div>
  {page.slug === 'changes' && <><nav class="history-navigation" aria-label="Jump to park history">{parks.map((park) => <a href={`#history-${park.code}`}>{park.name}</a>)}</nav>{parks.map((park) => <HistoryTimeline history={historyFor(park.code)} snapshot={snapshotFor(park.code)} title={`${park.name} notice history`} conditionsUrl={park.conditions_url} />)}</>}
</article></Layout>
<style>.history-navigation{display:flex;gap:12px 22px;flex-wrap:wrap;font-size:.8rem;margin:0 0 28px}</style>
