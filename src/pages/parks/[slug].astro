---
import type { InferGetStaticPropsType } from 'astro';
import Layout from '../../layouts/Layout.astro';
import EntryCheck from '../../components/EntryCheck.astro';
import EntryReviewNotice from '../../components/EntryReviewNotice.astro';
import Checklist from '../../components/Checklist.astro';
import UndatedGuidance from '../../components/UndatedGuidance.astro';
import HistoryTimeline from '../../components/HistoryTimeline.astro';
import PlanningResources from '../../components/PlanningResources.astro';
import { parks, rulesFor, notesFor, entryReviewHoldsFor, snapshotFor, historyFor, planningResourcesFor, buildInfo } from '../../lib/data';
import { describeAlerts } from '../../lib/readiness';
export function getStaticPaths() { return parks.map((park) => ({ params: { slug: park.slug }, props: { park } })); }
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { park } = Astro.props;
const parkRules = rulesFor(park.code);
const parkNotes = notesFor(park.code);
const snapshot = snapshotFor(park.code);
const notice = describeAlerts(snapshot, new Date());
---
<Layout title={`${park.name} trip readiness`}>
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/parks/">Explore parks</a><span aria-hidden="true">/</span><span>{park.name}</span></nav>
  <section class="park-intro"><div><p class="eyebrow">{park.states.join(' · ')} · National park</p><h1>{park.name}<span>Trip readiness</span></h1><p class="lead">{park.summary}</p></div><a class="button secondary" href={park.official_url}>Official park planning <span aria-hidden="true">↗</span></a></section>
  <section class="notice-panel" id="alert-status" data-snapshot={JSON.stringify(snapshot)} aria-labelledby="notice-title"><span class="status-symbol" aria-hidden="true">!</span><div><p class="eyebrow">Published restrictions · Coverage incomplete</p><h2 id="notice-title">{notice.title}</h2><p id="notice-detail">{notice.detail}</p><a class="text-link" href={park.conditions_url}>Check official conditions <span aria-hidden="true">↗</span></a><p class="small">Last successful automated check: {snapshot.last_successful_fetch_at ?? 'Never'}. Source update time: {snapshot.source_updated_at ?? 'Not supplied'}.</p></div></section>
  {snapshot.records.length > 0 && <section class="panel"><h2>Notices retained from the checked feed</h2><p>Area scope is not classified. These notices are not filtered to your travel date; applicability remains unconfirmed.</p>{snapshot.records.map((item) => <article class="source-item"><p class="eyebrow">{item.category} · Scope unclassified</p><h3>{item.title}</h3><p>{item.description}</p>{item.url ? <a href={item.url}>Read the official notice</a> : <p class="small muted">NPS did not supply a direct link for this alert.</p>}</article>)}</section>}
  {!parkRules.length && parkNotes.length > 0 && <p class="note">Only undated general-entry guidance is stored for this park. The date checker will not infer an exemption; read the source observation below.</p>}
  <EntryReviewNotice holds={entryReviewHoldsFor(park.code)} />
  <div class="readiness-grid"><EntryCheck park={park} /><Checklist /></div>
  <section class="panel source-panel" aria-labelledby="guidance-title"><div class="section-heading"><div><p class="eyebrow">Evidence, not a live check</p><h2 id="guidance-title">Stored entry guidance</h2></div><span class="tag">{parkRules.length ? 'Dated rules stored' : parkNotes.length ? 'Undated source review' : 'Review pending'}</span></div>
    {parkRules.map((rule) => <article class="source-item"><h3>{rule.areas.includes('bear-lake') ? 'Bear Lake Road Corridor' : rule.park_code === 'romo' ? 'Rest of park' : 'Park entrance'}</h3><p>{rule.summary}</p><p class="small">{rule.exception_note}</p><details><summary>View supporting text and evidence</summary><blockquote>{rule.evidence.excerpt}</blockquote><p class="small break-word">Excerpt SHA-256: <code>{rule.evidence.content_hash}</code></p><p class="small">This hash identifies the stored excerpt, not the complete source page.</p></details><p class="small muted">Reviewed from the official page: <time datetime={rule.reviewed_at}>{rule.reviewed_at}</time>.<br />Re-review due: <time datetime={new Date(Date.parse(rule.reviewed_at) + 168 * 3_600_000).toISOString()}>{new Date(Date.parse(rule.reviewed_at) + 168 * 3_600_000).toISOString()}</time>.</p><p class="small review-status" data-reviewed={rule.review_status === 'reviewed' ? rule.reviewed_at : undefined}>{rule.review_status === 'reviewed' ? 'Stored review only. Verify current guidance directly.' : 'This rule requires editorial review; do not rely on it.'}</p><a class="text-link" href={rule.evidence.url}>Read the official source <span aria-hidden="true">↗</span></a></article>)}
    <UndatedGuidance notes={parkNotes} />
    {!parkRules.length && !parkNotes.length && <div class="empty-state"><h3>No entry source has been reviewed for this park yet.</h3><p>No reservation conclusion is being made. Use the official planning page to check entry and activity requirements.</p><a class="text-link" href={park.entry_url}>Open official planning guidance <span aria-hidden="true">↗</span></a></div>}
    <p class="note">A source review does not confirm that roads, facilities or parking are available. This pilot does not yet monitor source changes automatically.</p>
  </section>
  <HistoryTimeline history={historyFor(park.code)} snapshot={snapshot} conditionsUrl={park.conditions_url} />
  <PlanningResources parkName={park.name} resources={planningResourcesFor(park.code)} />
  <p class="build-note small muted">Data snapshot: <code>{buildInfo.snapshot_id}</code>. Build created: <time datetime={buildInfo.built_at}>{buildInfo.built_at}</time>. This is not a source-check or publication time.</p>
</Layout>
<script>import '../../scripts/trip';</script>
