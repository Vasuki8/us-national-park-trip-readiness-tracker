---
import '../styles/global.css';
import '../styles/accessibility.css';
import { siteUrl } from '../lib/urls';
interface Props { title: string; description?: string }
const { title, description = 'Independent, source-backed planning checks for five U.S. national parks. Development pilot; not live condition monitoring.' } = Astro.props;
const path = Astro.url.pathname;
const url = (path: string) => siteUrl(path, import.meta.env.BASE_URL);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{title} · Park Readiness</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="pilot-bar"><div class="wrap"><strong>Development pilot</strong><span>Planning guidance, not live conditions.</span></div></div>
    <header class="site-header wrap">
      <a class="brand" href={url('/')} aria-label="Park Readiness home"><span class="brand-mark" aria-hidden="true">↗</span><span>Park <strong>Readiness</strong></span></a>
      <nav aria-label="Main navigation">
        <a href={url('/parks/')} aria-current={path === url('/parks/') ? 'page' : undefined}>Explore parks</a>
        <a href={url('/how-it-works/')} aria-current={path === url('/how-it-works/') ? 'page' : undefined}>How it works</a>
        <a href={url('/sources/')} aria-current={path === url('/sources/') ? 'page' : undefined}>Sources</a>
      </nav>
    </header>
    <main id="main" class="wrap" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="brand footer-brand" href={url('/')}>Park <strong>Readiness</strong></a><p>Know what is checked. Know what is still unknown.</p><p class="small">Independent project. Not affiliated with or endorsed by the National Park Service.<br />Source excerpts are attributed to the National Park Service. No protection is claimed in original U.S. Government works.<br />Not an emergency service or a guarantee of access, conditions or safety.</p></div>
      <nav aria-label="Footer navigation"><a href={url('/about/')} aria-current={path === url('/about/') ? 'page' : undefined}>About</a><a href={url('/privacy/')} aria-current={path === url('/privacy/') ? 'page' : undefined}>Privacy</a><a href={url('/terms/')} aria-current={path === url('/terms/') ? 'page' : undefined}>Use & limitations</a><a href={url('/corrections/')} aria-current={path === url('/corrections/') ? 'page' : undefined}>Report a correction</a><a href={url('/changes/')} aria-current={path === url('/changes/') ? 'page' : undefined}>Change history</a></nav>
    </footer>
  </body>
</html>
